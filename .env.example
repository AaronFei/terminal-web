# terminal-web environment configuration
# Copy to ".env" and adjust as needed. All values are optional; the defaults
# below match src/config.ts. (.env is gitignored.)
#
# NOTE: .env is loaded by scripts/start.sh and scripts/dev.sh (i.e. `npm run
# dev` and `bash scripts/start.sh`). Running `npm start` (tsx) directly does
# NOT auto-load it — in that case export the vars in your shell, e.g.
#   HOST=100.x.y.z PORT=8090 npm start

# Port the HTTP/WebSocket server listens on.
# Default: 8090
PORT=8090

# Address to bind the server to.
# If unset, the server auto-detects your Tailscale IPv4 (via "tailscale ip -4");
# if that fails it falls back to 0.0.0.0 (all interfaces).
# Set this explicitly to pin a specific interface/IP.
# Example: HOST=100.x.y.z
# HOST=

# Default tmux session name used when the client doesn't pass ?session=NAME.
# Session names are sanitized to [A-Za-z0-9_-]{1,64}.
# Default: web. Ignored in window mode (see MAIN_SESSION).
DEFAULT_SESSION=web

# Optional generic tmux window tabs; not tied to iTerm2 or another client.
# Default: 0 (original session tabs, including create / split / restart / kill).
# Set WINDOW_MODE=1 explicitly to show windows of an existing MAIN_SESSION.
WINDOW_MODE=0

# Window-mode target. Must match [A-Za-z0-9_-]{1,64}. Default: main.
# Ordinary view reconnect NEVER creates a missing session. Explicit restart
# may recreate it; the name is not protected from explicit tmux operations.
# MAIN_SESSION=main

# tmux -L socket name. Empty = the default socket. Tests must set a scratch
# name; every tmux command uses it. Do not point this at the production socket
# from a test.
# TMUX_SOCKET_NAME=

# Prefs and closed-tab files. Default: ~/.terminal-web
# TERMINAL_WEB_STATE_DIR=

# Shared access token. When set, requests arriving THROUGH Cloudflare (detected
# via the Cf-Ray / Cf-Connecting-Ip headers) must carry it: open once with
# ?token=<TOKEN> to set a cookie; the WebSocket is gated too. Direct Tailnet/LAN
# access stays token-free. Empty = no auth. Generate one: openssl rand -hex 24
# AUTH_TOKEN=

# Directory where pasted/dropped/attached files are saved (POST /upload). Any
# file type is accepted; the saved path is inserted at the prompt so a CLI like
# Claude Code can read it.
# Default: ~/terminal-web-uploads
# UPLOAD_DIR=

# Reject any single upload larger than this many MB (0 = no limit). Default: 25
# UPLOAD_MAX_MB=25

# Auto-cleanup of the upload dir (runs on boot and after each upload; only
# touches our own clip-* files). 0 disables that limit.
# Delete uploads older than this many hours. Default: 72
# UPLOAD_RETENTION_HOURS=72
# Keep at most this many uploads (newest kept). Default: 100
# UPLOAD_MAX_FILES=100
