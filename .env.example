# terminal-web environment configuration
# Copy to ".env" and adjust as needed. All values are optional; the defaults
# below match src/config.ts. (.env is gitignored.)
#
# NOTE: .env is loaded by scripts/start.sh and scripts/dev.sh (i.e. `npm run
# dev` and `bash scripts/start.sh`). Running `npm start` (tsx) directly does
# NOT auto-load it — in that case export the vars in your shell, e.g.
#   HOST=100.x.y.z PORT=8090 npm start
# The service installed by scripts/service.sh does not read .env either; it
# keeps its own copy of the settings (see the README).
#
# None of these variables reach the terminal's shell: the server removes all
# of them from the environment it starts tmux with.

# Port the HTTP/WebSocket server listens on.
# Default: 8090
PORT=8090

# Address to bind the server to.
# If unset, the server auto-detects your Tailscale IPv4 (via "tailscale ip -4");
# if that fails it falls back to 0.0.0.0 (all interfaces). scripts/start.sh and
# scripts/service.sh refuse that fallback: with no Tailscale IP they need HOST
# set (HOST=0.0.0.0 to bind every interface on purpose).
# Example: HOST=100.x.y.z
# HOST=

# Session used only when a WebSocket client connects without ?session=NAME.
# The bundled web page always sends one, so this matters only for raw
# WebSocket clients. Must match [A-Za-z0-9_-]{1,64}; anything else stops the
# server at startup.
# Default: web
DEFAULT_SESSION=web

# Shared access token for requests that arrive THROUGH Cloudflare (detected by
# the Cf-Ray / Cf-Connecting-Ip headers). Those requests get a sign-in page;
# signing in sets an HttpOnly cookie, and the WebSocket needs it too.
# Changing the token signs out every session made with it. Passkeys are an
# optional second way in, added from the app (? -> Passkeys); the token always
# keeps working.
# Empty = every Cloudflare-fronted request is refused (403).
# Requests that do NOT come through Cloudflare (tailnet, LAN, any other proxy
# or tunnel) never need the token: anyone who can reach the port gets a shell.
# Generate one: openssl rand -hex 24
# AUTH_TOKEN=

# Extra hostnames (comma-separated, no ports) allowed in the Host header of
# requests that don't come through Cloudflare. IPs, single-label names like
# "localhost" and *.ts.net names are always allowed; any other dotted name is
# refused with 403 (protection against DNS rebinding) unless listed here.
# Example: ALLOWED_HOSTS=term.example.lan,devbox.example.com
# ALLOWED_HOSTS=

# Most terminals (ptys) open at once; connections past it are refused.
# Protects the host's system-wide pty limit. Minimum 1. Default: 48
# MAX_PTYS=48

# Directory where pasted/dropped/attached files are saved (POST /upload). Any
# file type is accepted; the saved path is inserted at the prompt so a CLI like
# Claude Code can read it.
# Default: ~/terminal-web-uploads
# UPLOAD_DIR=

# Reject any single upload larger than this many MB (0 = no limit). Default: 1024
# UPLOAD_MAX_MB=1024

# Auto-cleanup of the upload dir (runs on boot and after each upload; only
# touches our own clip-* files). 0 disables that limit.
# Delete uploads older than this many hours. Default: 72
# UPLOAD_RETENTION_HOURS=72
# Keep at most this many uploads (newest kept). Default: 100
# UPLOAD_MAX_FILES=100

# For testing only: run every tmux command on `tmux -L <name>` instead of your
# default tmux server, and turn tmux-resurrect snapshots off. Must match
# [A-Za-z0-9_-]{1,64}. See scripts/smoke/run-smoke.sh.
# TERMINAL_WEB_TMUX_SOCKET=
